{
  "name": "@thej/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:fetcher": "tsx watch --env-file-if-exists=../../.env src/fetcher/index.ts",
    "dev:analysis": "tsx watch --env-file-if-exists=../../.env src/analysis/index.ts",
    "dev:planner": "tsx watch --env-file-if-exists=../../.env src/planner/index.ts",
    "typecheck": "tsc -p .",
    "seed": "tsx --env-file-if-exists=../../.env src/scripts/seed.ts",
    "status": "tsx --env-file-if-exists=../../.env src/scripts/status.ts",
    "requeue": "tsx --env-file-if-exists=../../.env src/scripts/requeue.ts",
    "crawl": "tsx --env-file-if-exists=../../.env src/catalog/crawl.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1154.0",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@thej/core": "workspace:*",
    "@thej/db": "workspace:*",
    "@thej/shared": "workspace:*",
    "ai": "^7.0.148",
    "bullmq": "^6.4.0",
    "drizzle-orm": "^0.45.4",
    "ioredis": "^6.0.0",
    "tsx": "^4.23.15",
    "youtubei.js": "^18.2.0",
    "zod": "^4.6.7"
  }
