{
  "name": "thej",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:api": "pnpm --filter @thej/api dev",
    "dev:fetcher": "pnpm --filter @thej/workers dev:fetcher",
    "dev:analysis": "pnpm --filter @thej/workers dev:analysis",
    "dev:planner": "pnpm --filter @thej/workers dev:planner",
    "dev:mobile": "pnpm --filter @thej/mobile start",
    "infra:up": "docker compose -f infra/dev.compose.yml up -d",
    "infra:down": "docker compose -f infra/dev.compose.yml down",
    "db:generate": "pnpm --filter @thej/db generate",
    "db:migrate": "pnpm --filter @thej/db migrate",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  }
}
