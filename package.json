{
  "name": "thej",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.3",
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "dev:api": "bun --filter @thej/api dev",
    "dev:fetcher": "bun --filter @thej/workers dev:fetcher",
    "dev:analysis": "bun --filter @thej/workers dev:analysis",
    "dev:planner": "bun --filter @thej/workers dev:planner",
    "dev:mobile": "bun --filter @thej/mobile start",
    "infra:up": "docker compose -f infra/dev.compose.yml up -d",
    "infra:down": "docker compose -f infra/dev.compose.yml down",
    "db:generate": "bun --filter @thej/db generate",
    "db:migrate": "bun --filter @thej/db migrate",
    "typecheck": "bun --filter '*' typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.2",
    "@types/bun": "^1.4.3",
    "typescript": "^7.0.2"
  }
}
