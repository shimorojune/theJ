# Copy to .env for local dev. Real values live in Dokploy env, never in git.

# Postgres / Redis / MinIO (defaults match infra/dev.compose.yml)
DATABASE_URL=postgres://thej:thej@localhost:5432/thej
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=audio
S3_ACCESS_KEY_ID=thej
S3_SECRET_ACCESS_KEY=thej-dev-secret
AUDIO_CACHE_MAX_GB=15

# api
PORT=3000
CLERK_SECRET_KEY=
AUDIO_URL_SIGNING_SECRET=change-me
PUBLIC_API_URL=http://localhost:3000   # Android emulator: http://10.0.2.2:3000

# fetcher: SOCKS5 egress (home proxy over Tailscale). Empty = direct (fine when the Mac is at home).
# Through the proxy from local Docker on macOS: run `pnpm proxy:forward`, then set
# HOME_PROXY=socks5h://deejay:<PROXY_PASS>@host.docker.internal:11080
HOME_PROXY=
HOME_PROXY_IP=
FALLBACK_PROXY=
FETCH_CONCURRENCY=1

# analysis
RECCOBEATS_BASE_URL=https://api.reccobeats.com

# planner / LLM
LASTFM_API_KEY=
OPENROUTER_API_KEY=
LLM_INTERPRET_MODEL=
LLM_REFILL_MODEL=
LLM_DAILY_CAP_PER_USER=50

# streamer: where pulled audio lives (shared between the streamer container and the api)
STREAM_DIR=
