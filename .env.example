# Copy to .env for local dev. Real values live in Dokploy env, never in git.

# Postgres / Redis / MinIO (defaults match infra/dev.compose.yml)
DATABASE_URL=postgres://thej:thej@localhost:5432/thej
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=audio
S3_ACCESS_KEY_ID=thej
S3_SECRET_ACCESS_KEY=thej-dev-secret
AUDIO_CACHE_MAX_GB=15

# api
PORT=3000
CLERK_SECRET_KEY=
AUDIO_URL_SIGNING_SECRET=change-me

# fetcher: SOCKS5 egress (home proxy over Tailscale). Empty = direct (dev only).
HOME_PROXY=
FALLBACK_PROXY=
FETCH_CONCURRENCY=2

# analysis
RECCOBEATS_BASE_URL=https://api.reccobeats.com

# planner / LLM
LASTFM_API_KEY=
OPENROUTER_API_KEY=
LLM_INTERPRET_MODEL=
LLM_REFILL_MODEL=
LLM_DAILY_CAP_PER_USER=50

# web PWA (Vite reads VITE_* from this root .env). Dev proxies /api to the local api.
VITE_API_URL=
VITE_CLERK_PUBLISHABLE_KEY=
